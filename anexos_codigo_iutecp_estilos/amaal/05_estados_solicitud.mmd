%% Amaal — Estados de una solicitud de servicio
%%{init: {"theme":"base","themeVariables":{"fontFamily":"Tahoma, DejaVu Sans, sans-serif","background":"#FAF8FD","primaryColor":"#EDE3F7","primaryTextColor":"#24182D","primaryBorderColor":"#5B2A86","lineColor":"#24182D","tertiaryColor":"#FAF8FD"},"flowchart":{"curve":"linear","nodeSpacing":30,"rankSpacing":35}}}%%
flowchart TB
    subgraph FILA1[ ]
      direction LR
      A([Recibida]) --> B[Registrada] --> C[Asignada]
    end
    subgraph FILA2[ ]
      direction LR
      D[En atención] --> E[Resuelta] --> F([Cerrada])
    end
    C --> D

    classDef estado fill:#EDE3F7,stroke:#5B2A86,color:#24182D,stroke-width:1.4px;
    classDef atencion fill:#9B6BC4,stroke:#5B2A86,color:#24182D,stroke-width:1.4px;
    class A,B,C,E,F estado;
    class D atencion;
    style FILA1 fill:none,stroke:none
    style FILA2 fill:none,stroke:none
